<?xml version="1.0" encoding="utf-8"?>
<!--
  Profile, weight and meal data never leaves the device: cloud backup and device transfer
  are excluded for every data domain. `android:allowBackup="false"` covers Android 11 and
  lower, this file covers Android 12 and higher.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
