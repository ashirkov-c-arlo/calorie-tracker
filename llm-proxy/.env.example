# Copy to .env, fill in, never commit the result.

# Comma separated. Must match BuildConfig.LLM_API_KEY in the app.
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEYS=replace-me

AWS_REGION=eu-west-1
# Bedrock invoke ids. Confirm the exact eu.* inference profile ids in your account:
#   aws bedrock list-inference-profiles --region eu-west-1
MODEL_TEXT=eu.anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_VISION=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# Optional: tried once when the primary model keeps failing with a retryable error.
MODEL_FALLBACK=

# AWS credentials come from the standard boto3 chain: env vars, a mounted ~/.aws, or
# an instance role. Never bake them into the image.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Kill switch: false answers 503 UNKNOWN and the app degrades to manual tracking.
ENABLED=true

# Hard caps. Requests that never reach the model are not counted.
DAILY_REQUEST_CAP=100
MONTHLY_REQUEST_CAP=3000
PER_IP_DAILY_CAP=40
RATE_PER_SECOND=2
RATE_BURST=5

# Enable only behind a reverse proxy you control; a spoofed header defeats PER_IP_DAILY_CAP.
TRUST_FORWARDED_FOR=false

HOST=0.0.0.0
PORT=8080
DB_PATH=/data/kcal_proxy.sqlite3
